{
  "name": "the-sovelle-spin",
  "version": "1.0.0",
  "private": true,
  "description": "THE SOVELLE SPIN — Interactive luxury lucky spin web application for SOVELLE handmade bouquets",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"magenta,yellow\" \"node --watch server/index.js\" \"vite\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "db:reset": "node server/seed.js --reset",
    "pages:dev": "wrangler pages dev dist --d1=DB",
    "pages:deploy": "vite build && wrangler pages deploy dist --project-name=the-sovelle-spin",
    "d1:create": "wrangler d1 create sovelle-spin-db",
    "d1:seed:local": "wrangler d1 execute sovelle-spin-db --local --file=./d1-schema.sql",
    "d1:seed:remote": "wrangler d1 execute sovelle-spin-db --remote --file=./d1-schema.sql",
    "d1:reset:local": "wrangler d1 execute sovelle-spin-db --local --command=\"DELETE FROM customers; DELETE FROM spins; DELETE FROM coupon_codes;\""
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.8",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.8",
    "vite": "^6.2.0",
    "wrangler": "^3.114.17"
  }
}
