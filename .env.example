# Server Configuration
PORT=3001
NODE_ENV=development

# Cryptographic secret for signing HttpOnly session cookies (change in production!)
SESSION_SECRET=replace-with-a-64-char-random-hex-secret

# Initial Admin Account (seeded on first boot if admin_accounts table is empty)
ADMIN_USERNAME=sovelle-admin
ADMIN_PASSWORD=change-this-strong-password
ADMIN_FULL_NAME=SOVELLE Atelier Admin

# SQLite Database File Path
DB_PATH=./data/sovelle.db
